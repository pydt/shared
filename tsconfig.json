{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "strictNullChecks": true,
    "paths": {
      "pydt-shared-lib": ["./dist/pydt-shared-lib"],
      "pydt-shared-lib/*": ["./dist/pydt-shared-lib/*"]
    },
    "useDefineForClassFields": false
  }
}
