{
  "name": "pydt-shared",
  "version": "0.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-lib": "npm run lint && ng test pydt-shared-lib --watch=false --browsers=ChromeHeadless && ng build --configuration production pydt-shared-lib && sh create-models.sh",
    "test": "ng test",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix",
    "swagger-codegen": "bash -c \"mkdir -p .tmp && cp ../api/api/_gen/swagger/swagger.json .tmp/swagger.json && MSYS_NO_PATHCONV=1 docker run --rm -v ${PWD}:/local swaggerapi/swagger-codegen-cli:2.4.23 generate -i /local/.tmp/swagger.json -l typescript-angular --additional-properties ngVersion=12 -o /local/projects/pydt-shared-lib/src/lib/_gen/swagger/api -DmodelPropertyNaming=original\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "core-js": "^3.39.0",
    "ngx-bootstrap": "^22.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular-eslint/builder": "^22.8.0",
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/schematics": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@types/jasmine": "^5.1.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript-eslint/utils": "^8.73.0",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.5.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^22.2.6",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "zone.js": "^0.16.3"
  }
}
